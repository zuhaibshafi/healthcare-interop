### FhirIntegration.Api sample requests
### Works with the VS Code "REST Client" extension, Rider, or Visual Studio's .http support.
@base = http://localhost:5080
@hapi = http://localhost:8080/fhir

### ---------------------------------------------------------------- Health / discovery

### Health of all upstreams (HAPI, validator, eCRNow)
GET {{base}}/health

### Swagger document
GET {{base}}/swagger/v1/swagger.json

### SMART discovery for the token facade
GET {{base}}/.well-known/smart-configuration

### ---------------------------------------------------------------- FHIR gateway

### CapabilityStatement summary
GET {{base}}/api/fhir/metadata

### Search patients (simplified DTO list)
GET {{base}}/api/patients?family=Shaw

### Search by MRN
GET {{base}}/api/patients?identifier=MRN-000001

### Raw FHIR Patient
GET {{base}}/api/patients/demo-patient-1

### Create a US Core Patient from a simplified DTO
# @name createPatient
POST {{base}}/api/patients
Content-Type: application/json

{
  "family": "Test",
  "given": "Integration",
  "gender": "male",
  "birthDate": "1990-05-05",
  "mrn": "MRN-SMOKE-001"
}

### Update a Patient with raw FHIR (id in the URL wins)
PUT {{base}}/api/patients/{{createPatient.response.body.id}}
Content-Type: application/fhir+json

{
  "resourceType": "Patient",
  "meta": { "profile": [ "http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient" ] },
  "name": [ { "family": "Test", "given": [ "Integration", "Updated" ] } ],
  "gender": "male",
  "birthDate": "1990-05-05"
}

### Delete the test Patient
DELETE {{base}}/api/patients/{{createPatient.response.body.id}}

### Patient-scoped searches
GET {{base}}/api/patients/demo-patient-1/encounters

###
GET {{base}}/api/patients/demo-patient-1/conditions

###
GET {{base}}/api/patients/demo-patient-1/observations?category=vital-signs

### Patient/$everything with per-type counts
GET {{base}}/api/patients/demo-patient-1/everything

### Create a US Core Encounter
POST {{base}}/api/encounters
Content-Type: application/json

{
  "patientId": "demo-patient-1",
  "start": "2026-11-08T09:00:00-05:00",
  "end": "2026-11-08T09:30:00-05:00",
  "classCode": "AMB",
  "typeText": "Office Visit",
  "status": "finished"
}

### Forward a transaction Bundle to HAPI
POST {{base}}/api/fhir/transaction
Content-Type: application/fhir+json

{
  "resourceType": "Bundle",
  "type": "transaction",
  "entry": [
    {
      "fullUrl": "urn:uuid:obs-1",
      "resource": {
        "resourceType": "Observation",
        "status": "final",
        "category": [ { "coding": [ { "system": "http://terminology.hl7.org/CodeSystem/observation-category", "code": "vital-signs" } ] } ],
        "code": { "coding": [ { "system": "http://loinc.org", "code": "8867-4", "display": "Heart rate" } ] },
        "subject": { "reference": "Patient/demo-patient-1" },
        "effectiveDateTime": "2026-11-08T09:10:00-05:00",
        "valueQuantity": { "value": 72, "unit": "beats/minute", "system": "http://unitsofmeasure.org", "code": "/min" }
      },
      "request": { "method": "POST", "url": "Observation" }
    }
  ]
}

### Validate a resource against a profile via HAPI $validate
POST {{base}}/api/fhir/validate?profile=http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient
Content-Type: application/fhir+json

{
  "resourceType": "Patient",
  "name": [ { "family": "Shaw", "given": [ "Amy" ] } ],
  "gender": "female"
}

### ---------------------------------------------------------------- OAuth2 facade (eCRNow "System" auth)

### Token with HTTP Basic client authentication
POST {{base}}/oauth/token
Content-Type: application/x-www-form-urlencoded
Authorization: Basic ZWNybm93LWxvY2FsOmVjcm5vdy1zZWNyZXQ=

grant_type=client_credentials&scope=system/*.read

### Token with client_id / client_secret in the form body
POST {{base}}/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=ecrnow-local&client_secret=ecrnow-secret

### ---------------------------------------------------------------- PHA receiver mock

### CapabilityStatement that eCRNow's FHIR client probes before calling $process-message
GET {{base}}/pha/r4/fhir/metadata

### eCRNow posts eICR message bundles here
POST {{base}}/pha/r4/fhir/$process-message
Content-Type: application/fhir+json

{
  "resourceType": "Bundle",
  "id": "eicr-sample-1",
  "type": "message",
  "timestamp": "2026-11-08T12:00:00Z",
  "entry": [
    {
      "fullUrl": "urn:uuid:mh-1",
      "resource": {
        "resourceType": "MessageHeader",
        "id": "mh-1",
        "eventCoding": { "system": "http://hl7.org/fhir/us/ecr/CodeSystem/us-ph-messageheader-message-types", "code": "case-report" },
        "source": { "name": "eCRNow", "endpoint": "http://localhost:8081" },
        "destination": [ { "endpoint": "http://localhost:5080/pha/r4/fhir/$process-message" } ],
        "focus": [ { "reference": "urn:uuid:pat-1" } ]
      }
    },
    {
      "fullUrl": "urn:uuid:pat-1",
      "resource": { "resourceType": "Patient", "id": "demo-patient-1", "name": [ { "family": "Shaw", "given": [ "Amy" ] } ], "gender": "female", "birthDate": "1987-02-20" }
    }
  ]
}

### List received eICRs
GET {{base}}/pha/received

### ---------------------------------------------------------------- eCRNow client

### Launch eCRNow for a patient/encounter
POST {{base}}/api/ecr/launch
Content-Type: application/json

{
  "patientId": "demo-patient-1",
  "encounterId": "demo-encounter-1"
}

### eCRNow healthcare settings
GET {{base}}/api/ecr/healthcare-settings

### ---------------------------------------------------------------- UDS+ pipeline

### Run the whole Data Submitter pipeline (export -> de-identify -> manifest -> validate -> $import)
### First run with validate=true can take several minutes while the validator downloads the UDS+ IG.
POST {{base}}/api/udsplus/submit?groupId=uds-plus-reporting-group&validate=true

### Same without validation (fast)
POST {{base}}/api/udsplus/submit?groupId=uds-plus-reporting-group&validate=false

### Previous runs and their artefacts
GET {{base}}/api/udsplus/runs

### Download a de-identified NDJSON file (replace runId)
GET {{base}}/udsplus/files/REPLACE-RUN-ID/Patient.ndjson

### Submissions seen by the mock HRSA receiver
GET {{base}}/udsplus/received

### Status of one submission (replace id)
GET {{base}}/udsplus/$import-status/REPLACE-ID

### Direct call to the mock receiver with a hand-written manifest
POST {{base}}/udsplus/$import
Content-Type: application/fhir+json

{
  "resourceType": "Parameters",
  "meta": { "profile": [ "http://fhir.org/guides/hrsa/uds-plus/StructureDefinition/uds-plus-import-manifest" ] },
  "parameter": [
    { "name": "inputFormat", "valueCode": "fhir+ndjson" },
    { "name": "submissionId", "valueString": "manual-1" },
    { "name": "submissionTime", "valueDateTime": "2026-11-08T12:00:00Z" },
    { "name": "importProtocol", "valueCode": "https" },
    {
      "name": "udsData",
      "part": [
        { "name": "type", "valueCode": "Patient" },
        { "name": "url", "valueUrl": "http://localhost:5080/udsplus/files/REPLACE-RUN-ID/Patient.ndjson" },
        { "name": "expirationTime", "valueDateTime": "2026-12-08T12:00:00Z" }
      ]
    }
  ]
}
