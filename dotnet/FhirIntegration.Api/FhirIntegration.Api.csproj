<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FhirIntegration.Api</RootNamespace>
    <Description>FHIR integration layer PoC: HAPI gateway, OAuth2 facade for eCRNow, PHA receiver mock, UDS+ Data Submitter pipeline.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Firely .NET SDK: FHIR R4 POCO models, FhirClient (REST), FhirJsonSerializer/Parser -->
    <PackageReference Include="Hl7.Fhir.R4" Version="5.13.4" />
    <!-- Swagger / OpenAPI UI at /swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
