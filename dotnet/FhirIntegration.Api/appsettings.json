{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Fhir": {
    "BaseUrl": "http://localhost:8080/fhir",
    "ValidatorUrl": "http://localhost:8082",
    "EcrNowUrl": "http://localhost:8081",
    "OutputDirectory": "C:/git/interop-assessment/results/dotnet-output",
    "PublicBaseUrl": "http://localhost:5080"
  },

  "Auth": {
    "Issuer": "http://localhost:5080",
    "SigningKey": "dev-only-hs256-signing-key-please-change-0123456789",
    "TokenLifetimeSeconds": 3600,
    "Clients": [
      {
        "ClientId": "ecrnow-local",
        "ClientSecret": "ecrnow-secret",
        "Scopes": "system/*.read system/*.write"
      }
    ]
  },

  "UdsPlus": {
    "ExportResourceTypes": [ "Patient", "Encounter", "Condition", "Procedure", "Observation", "Immunization", "MedicationRequest", "AllergyIntolerance" ],
    "ValidatorIgs": [ "fhir.hrsa.uds-plus#2.0.0" ],
    "ExportPollIntervalSeconds": 2,
    "ExportTimeoutSeconds": 180,
    "MaxResourcesToValidatePerType": 50,
    "HealthCenter": {
      "Uei": "DEMO12345678",
      "GrantNumber": "H80CS00000",
      "Name": "Demo Community Health Center",
      "AddressLine": "100 Interop Way",
      "City": "Atlanta",
      "State": "GA",
      "PostalCode": "30301",
      "ContactFamily": "Reporter",
      "ContactGiven": "Uds",
      "ContactPhone": "555-010-0000",
      "PrenatalCareByReferralOnly": false
    }
  }
}
